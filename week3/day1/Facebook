package week3.day1;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.Select;

import io.cucumber.messages.types.TestCase;

public class CreateAccount {

	public static void main(String[] args) throws InterruptedException {
		// TODO Auto-generated method stub
		ChromeDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.get("http://leaftaps.com/opentaps/control/main");
		driver.findElement(By.id("username")).sendKeys("DemoCSR2");
		driver.findElement(By.id("password")).sendKeys("crmsfa");
		driver.findElement(By.className("decorativeSubmit")).click();
		driver.findElement(By.linkText("CRM/SFA")).click();
		
		driver.findElement(By.linkText("Accounts")).click();
		driver.findElement(By.linkText("Create Account")).click();
		
		//description as Selenium Automation Tester
		
		WebElement inputText = driver.findElement(By.xpath("//input[@id='accountName']"));
		inputText.sendKeys("Test Account4");
		
		driver.findElement(By.name("description")).sendKeys("Selenium Automation Tester");
		
		Thread.sleep(4000);
		
		WebElement d1 = driver.findElement(By.name("industryEnumId"));
		Select s1 = new Select(d1);
		s1.selectByVisibleText("Computer Software");
		
		WebElement d2 = driver.findElement(By.name("ownershipEnumId"));
		Select s2 = new Select(d2);
		s2.selectByVisibleText("S-Corporation");
		
		Thread.sleep(2000);
		
		WebElement d3 = driver.findElement(By.id("dataSourceId"));
		Select p3 = new Select(d3);
		p3.selectByValue("LEAD_EMPLOYEE");
		
		WebElement d4 = driver.findElement(By.id("marketingCampaignId"));
		Select p4 = new Select(d4);
		p4.selectByIndex(6);
		
		Thread.sleep(3000);
		
		driver.findElement(By.className("smallSubmit")).click();
		
		String expectedName = "Test Account4";
		
		if(expectedName.contains("Test Account4"))
		
		{
			System.out.println("Account name is displayed correctly");
		}
		else
		{
			System.out.println("Account name is displayed incorrectly");
		}
		
		Thread.sleep(3000);
		
		
		
		
	}

}
